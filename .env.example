# 老师登录 session 密钥（至少 32 位随机字符，生产环境务必修改）
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-chars-xxxxxx

# SQLite 数据库文件路径
DB_PATH=./data/class-records.db

# ============ 短信续费提醒 ============
# 通道：console = 占位模式，提醒内容只写入服务器日志，不真实发送、不产生费用
#       aliyun  = 阿里云短信；以下五项必须全部配齐，否则自动降级为占位模式
NUXT_SMS_PROVIDER=console

# 阿里云 RAM 子账号 AccessKey（需授予短信发送权限）
NUXT_SMS_ALIYUN_ACCESS_KEY_ID=
NUXT_SMS_ALIYUN_ACCESS_KEY_SECRET=
NUXT_SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com

# 已审批通过的短信签名，如：XX舞蹈
NUXT_SMS_SIGN_NAME=
# 已审批通过的模板 CODE（SMS_ 开头）
# 低课时模板变量：${name} ${remaining}
NUXT_SMS_TEMPLATE_LOW=
# 临期模板变量：${name} ${days} ${date}
NUXT_SMS_TEMPLATE_EXPIRING=
